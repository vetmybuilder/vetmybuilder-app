# ──────────────────────────────────────────────────────────────────────
# VetMyBuilder — environment variables
# Copy to .env locally and fill in real values. .env is gitignored.
# ──────────────────────────────────────────────────────────────────────

# ── Core server ──────────────────────────────────────────────────────
PORT=8787
FIREBASE_ADMIN_CREDENTIALS_JSON=
ENABLE_TEST_ROUTES=1
E2E_TEST_SECRET=

# ── MySQL ────────────────────────────────────────────────────────────
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# ── External services ────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
CH_ENV=live
CH_KEY=

# ── Stripe ───────────────────────────────────────────────────────────
# Local dev: leave STRIPE_SECRET_KEY unset (mock driver auto-selects)
# Staging:   sk_test_... + STRIPE_WEBHOOK_SECRET from the staging
#            webhook endpoint configured in the Stripe Dashboard
# Prod:      sk_live_... + STRIPE_WEBHOOK_SECRET from the live webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Base URL for Stripe success/cancel redirects. Required when
# STRIPE_SECRET_KEY is set. Local: http://localhost:3000
# Staging: https://staging.vetmybuilder.com
# Prod:    https://vetmybuilder.com
PAYMENTS_BASE_URL=
NEXT_PUBLIC_WEB_BASE=

# Master gate for trade-side paid features in the UI. Set to "true" to
# enable Plans upgrade UX. Leave unset or "false" during the free
# launch period.
NEXT_PUBLIC_ENABLE_PAYMENTS=

# Force-mock external services (Google Places, Anthropic, Companies
# House). Does NOT affect payments (see MOCK_PAYMENTS).
MOCK_EXTERNAL_SERVICES=

# Force-mock Stripe specifically.
# CI / E2E: 1   Staging: 0   Prod: 0
# Unset: falls back to MOCK_EXTERNAL_SERVICES for backward compat.
MOCK_PAYMENTS=

# Optional override for the unlock-contact base price (pence). Leave
# unset to use the price-band ladder in unlock-contact.checkout.post.js.
ONEOFF_UNLOCK_PRICE_PENCE=
