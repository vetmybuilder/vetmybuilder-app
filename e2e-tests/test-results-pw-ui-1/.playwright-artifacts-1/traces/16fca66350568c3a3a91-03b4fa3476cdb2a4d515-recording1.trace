: 150ms;\n}\n.transition-colors {\n  transition-property: color, background-color, border-color, text-decoration-color, fill, stroke;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-opacity {\n  transition-property: opacity;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-shadow {\n  transition-property: box-shadow;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.transition-transform {\n  transition-property: transform;\n  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);\n  transition-duration: 150ms;\n}\n.duration-150 {\n  transition-duration: 150ms;\n}\n.duration-300 {\n  transition-duration: 300ms;\n}\n.ease-out {\n  transition-timing-function: cubic-bezier(0, 0, 0.2, 1);\n}\n\n/* ---------- Theme ---------- */\n:root {\n  --bg: #f1f2f5; /* soft off-white/grey background */\n  --panel: #ffffff; /* cards */\n  --text: #0f172a; /* slate-900 */\n  --muted: #64748b; /* slate-500 */\n  --border: #e6e8ee; /* cool border */\n  --input: #ffffff;\n\n  /* brand */\n  --brand: #2563eb; /* blue-600 */\n  --brand-700: #1d4ed8;\n  --brand-50: #eef2ff;\n}\n\nhtml,\nbody,\n#__next {\n  height: 100%;\n}\n\nbody {\n  /* Neutral, subtle vignette over a soft off-white base */\n  background:\n    radial-gradient(\n      1200px 600px at 10% -10%,\n      rgba(15, 23, 42, 0.06),\n      transparent 60%\n    ),\n    radial-gradient(\n      900px 500px at 110% 0%,\n      rgba(15, 23, 42, 0.04),\n      transparent 55%\n    ),\n    var(--bg);\n  color: var(--text);\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n/* ---------- Layout ---------- */\n.container {\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: 1rem;\n}\n\n/* ---------- Surfaces ---------- */\n.card {\n  background: linear-gradient(#fff, #fff) padding-box,\n    linear-gradient(180deg, rgba(37, 99, 235, 0.18), rgba(37, 99, 235, 0))\n      border-box;\n  border: 1px solid transparent; /* gradient border from bg layers */\n  border-radius: 18px;\n  padding: 1.25rem;\n  box-shadow: 0 6px 24px rgba(15, 23, 42, 0.06),\n    0 2px 8px rgba(15, 23, 42, 0.04);\n}\n\nh1,\nh2,\nh3 {\n  letter-spacing: -0.015em;\n}\n\n/* ---------- Inputs ---------- */\n.input {\n  background: var(--input);\n  border: 1px solid var(--border);\n  border-radius: 12px;\n  padding: 0.7rem 0.9rem;\n  width: 100%;\n  color: var(--text);\n  outline: none;\n  transition: box-shadow 0.15s ease, border-color 0.15s ease;\n  box-shadow: inset 0 1px 0 rgba(15, 23, 42, 0.03);\n}\n.input:focus {\n  border-color: var(--brand);\n  box-shadow: 0 0 0 4px rgba(37, 99, 235, 0.15);\n}\n.input::-moz-placeholder {\n  color: var(--muted);\n}\n.input::placeholder {\n  color: var(--muted);\n}\n\n/* ---------- Buttons ---------- */\n.btn {\n  background: var(--brand);\n  color: #fff;\n  border-radius: 9999px; /* pill */\n  padding: 0.65rem 1.05rem;\n  font-weight: 600;\n  border: 1px solid transparent;\n  box-shadow: 0 6px 14px rgba(37, 99, 235, 0.18);\n  transition: transform 0.02s ease, background-color 0.15s ease,\n    box-shadow 0.15s ease;\n}\n.btn:hover {\n  background: var(--brand-700);\n  box-shadow: 0 8px 18px rgba(37, 99, 235, 0.24);\n}\n.btn:active {\n  transform: translateY(1px);\n}\n.btn:disabled {\n  opacity: 0.6;\n  cursor: not-allowed;\n}\n\n.btn-outline {\n  background: #fff;\n  color: var(--text);\n  border: 1px solid var(--border);\n  border-radius: 9999px;\n  padding: 0.6rem 1rem;\n}\n.btn-outline:hover {\n  background: #f8fafc;\n}\n\n.btn-ghost {\n  background: transparent;\n  color: var(--brand);\n  border: 1px dashed rgba(37, 99, 235, 0.35);\n  border-radius: 9999px;\n  padding: 0.6rem 1rem;\n}\n.btn-ghost:hover {\n  background: rgba(37, 99, 235, 0.06);\n}\n\n.btn-danger {\n  background: #ef4444;\n  color: #fff;\n  border-radius: 9999px;\n  padding: 0.65rem 1.05rem;\n  box-shadow: 0 6px 14px rgba(239, 68, 68, 0.18);\n}\n.btn-danger:hover {\n  background: #dc2626;\n}\n\n/* ---------- Tables & Links ---------- */\n.table {\n  width: 100%;\n  border-collapse: collapse;\n}\n.table th,\n.table td {\n  border-bottom: 1px solid var(--border);\n  padding: 0.75rem;\n  text-align: left;\n}\na.link {\n  color: #1d4ed8;\n}\n\n/* ---------- Badges / Chips ---------- */\n.badge {\n  border-radius: 9999px;\n  padding: 0.25rem 0.55rem;\n  font-size: 0.75rem;\n  line-height: 1rem;\n  border: 1px solid transparent;\n}\n.badge.blue {\n  background: var(--brand-50);\n  color: #1d4ed8;\n  border-color: rgba(37, 99, 235, 0.25);\n}\n.badge.green {\n  background: #ecfdf5;\n  color: #065f46;\n  border-color: rgba(16, 185, 129, 0.3);\n}\n.badge.orange {\n  background: #fff7ed;\n  color: #9a3412;\n  border-color: rgba(251, 146, 60, 0.35);\n}\n.badge.gray {\n  background: #f1f5f9;\n  color: #334155;\n  border-color: rgba(148, 163, 184, 0.35);\n}\n\n/* ---------- Divider ---------- */\n.divider {\n  height: 1px;\n  background: linear-gradient(90deg, transparent, #e6e8ee, transparent);\n  margin: 0.75rem 0 1rem;\n}\n\n/* globals.css (Tailwind) */\n.file\\:mr-3::file-selector-button {\n  margin-right: 0.75rem;\n}\n.file\\:rounded::file-selector-button {\n  border-radius: 0.25rem;\n}\n.file\\:border-0::file-selector-button {\n  border-width: 0px;\n}\n.file\\:bg-indigo-50::file-selector-button {\n  --tw-bg-opacity: 1;\n  background-color: rgb(238 242 255 / var(--tw-bg-opacity, 1));\n}\n.file\\:px-3::file-selector-button {\n  padding-left: 0.75rem;\n  padding-right: 0.75rem;\n}\n.file\\:py-1\\.5::file-selector-button {\n  padding-top: 0.375rem;\n  padding-bottom: 0.375rem;\n}\n.file\\:text-indigo-700::file-selector-button {\n  --tw-text-opacity: 1;\n  color: rgb(67 56 202 / var(--tw-text-opacity, 1));\n}\n.placeholder\\:text-slate-400::-moz-placeholder {\n  --tw-text-opacity: 1;\n  color: rgb(148 163 184 / var(--tw-text-opacity, 1));\n}\n.placeholder\\:text-slate-400::placeholder {\n  --tw-text-opacity