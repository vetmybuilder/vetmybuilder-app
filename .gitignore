# Node
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/

# Environment (root & subpackages)
.env
.env.*
!.env.example
!.env.sample

# Image uploads
uploads/

# SQLite & local data — keep folder, ignore its contents
/data/*
!/data/.gitkeep
# If you store seeds or docs in data/, keep them too:
!/data/README.md
!/data/*.sql

# Defensive ignores (if any DBs escape the folder)
/*.sqlite
server/data/*.db
/*.db-shm
/*.db-wal
**/*.sqlite
**/*.db-shm
**/*.db-wal

# Build artifacts (generic)
dist/
build/
tmp/
temp/
.cache/

# Test artifacts
coverage/
test-results/
playwright-report/
playwright/.cache/
.tmpdb-*/

# Next.js (if built from root)
.next/
out/

# Logs
*.log

# E2E workspace (if present)
e2e-tests/node_modules/
e2e-tests/test-results/
e2e-tests/playwright-report/
web/firebase-admin.json

# DB dumps
*.sql
!docker/mysql/init/*.sql

# Local migration scripts
scripts/sqlite_to_mysql_schema.js

.claude/