# Environment (root & subpackages)
.env
.env.*
!.env.example
!.env.sample

# Image uploads
uploads/

# SQLite & local data — keep folder, ignore its contents
/data/*
!/data/.gitkeep
# If you store seeds or docs in data/, keep them too:
!/data/README.md
!/data/*.sql

# Defensive ignores (if any DBs escape the folder)
/*.sqlite
server/data/*.db
/*.db-shm
/*.db-wal
**/*.sqlite
**/*.db-shm
**/*.db-wal

# Build artifacts (generic)
dist/
build/
tmp/
temp/
.cache/

# Test artifacts
coverage/
test-results/
playwright-report/
playwright/.cache/
.tmpdb-*/

# Next.js (if built from root)
.next/
out/

# Logs
*.log

# E2E workspace (if present)
e2e-tests/node_modules/
e2e-tests/test-results/
e2e-tests/playwright-report/
web/firebase-admin.json

# DB dumps
*.sql
!docker/mysql/init/*.sql
!e2e-tests/sql/*.sql
!mysql_schema.sql

# Local migration scripts
scripts/sqlite_to_mysql_schema.js

# Simulation state
.sim-state.json

# Simulation photo fixtures (binary files — keep locally only)
scripts/sim/fixtures/photos/
scripts/sim/fixtures/builder-photos/

.firebase-emulator-data/

# Pitch deck and Project Lighthouse — local-only artifacts.
# Keep the build scripts under scripts/ tracked, but the generated decks,
# videos, screenshots and draft business content stay off git so they don't
# end up on master or in any clone of the repo. Regenerate via:
#   python3 scripts/build-pitch-deck.py
#   python3 scripts/build-lighthouse-deck.py
#   node scripts/capture-pitch-screenshots.js
#   node scripts/record-pitch-demo.js
pitch-deck/
project-lighthouse/
project-vault/
docs/superpowers/
