{
  "name": "vetmybuilder-monorepo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:web": "cd web && next dev -p 3000",
    "dev:server": "node server/index.js",
    "dev:e2e": "npm-run-all -p dev:e2e:*",
    "dev:e2e:server": "MYSQL_DATABASE=vetmybuilder_test_s1_4_w0 TEST_ENV=e2e TEST_TOTAL_SHARDS=4 TEST_SHARD=0 PORT=3100 node server/index.js",
    "dev:e2e:web": "NEXT_PUBLIC_API_BASE=http://localhost:3100 npm --prefix web run dev",
    "build": "cd web && next build",
    "start": "npm-run-all -p start:*",
    "start:web": "cd web && next start -p 3000",
    "start:server": "node server/index.js",
    "test:api": "vitest run -c vitest.config.ts",
    "test:web": "vitest run -c vitest.web.config.mts",
    "test": "npm run test:web && npm run test:api",
    "posttest": "node -e \"const fs=require('fs'),path=require('path'),os=require('os');const del=(dir,prefix)=>{try{for(const e of fs.readdirSync(dir,{withFileTypes:true})){if(e.isDirectory()&&e.name.startsWith(prefix)){fs.rmSync(path.join(dir,e.name),{recursive:true,force:true});}}}catch{}};del(process.cwd(),'.tmpdb-');del(os.tmpdir(),'vmb-tmpdb-');\"",
    "dev:manual": "NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npm-run-all dev:manual:preflight -p dev:manual:firebase dev:manual:server:all dev:manual:web dev:manual:proxy:all dev:manual:sim",
    "dev:manual:nosim": "NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 npm-run-all dev:manual:preflight -p dev:manual:firebase dev:manual:server:all dev:manual:web dev:manual:proxy:all",
    "dev:manual:sim": "node scripts/dev-manual-sim.js",
    "dev:manual:firebase": "node scripts/dev-manual-firebase.js",
    "dev:manual:preflight": "node scripts/dev-manual-preflight.js",
    "dev:manual:server": "node scripts/dev-manual-server.js",
    "dev:manual:server:w0": "TEST_TOTAL_SHARDS=4 TEST_SHARD=0 PORT=3100 node scripts/dev-manual-server.js",
    "dev:manual:server:w1": "TEST_TOTAL_SHARDS=4 TEST_SHARD=1 PORT=3101 node scripts/dev-manual-server.js",
    "dev:manual:server:w2": "TEST_TOTAL_SHARDS=4 TEST_SHARD=2 PORT=3102 node scripts/dev-manual-server.js",
    "dev:manual:server:w3": "TEST_TOTAL_SHARDS=4 TEST_SHARD=3 PORT=3103 node scripts/dev-manual-server.js",
    "dev:manual:server:all": "npm-run-all -p dev:manual:server:w0 dev:manual:server:w1 dev:manual:server:w2 dev:manual:server:w3",
    "dev:manual:web": "node scripts/dev-manual-web.js",
    "dev:manual:proxy:w1": "SHARD_INDEX=1 node scripts/dev-manual-proxy.js",
    "dev:manual:proxy:w2": "SHARD_INDEX=2 node scripts/dev-manual-proxy.js",
    "dev:manual:proxy:w3": "SHARD_INDEX=3 node scripts/dev-manual-proxy.js",
    "dev:manual:proxy:all": "npm-run-all -p dev:manual:proxy:w1 dev:manual:proxy:w2 dev:manual:proxy:w3",
    "dev:manual:clean": "node scripts/dev-manual-clean.js",
    "dev:manual:stop": "node scripts/dev-manual-stop.js",
    "sim:seed": "node scripts/simulate.js seed",
    "sim:daemon": "SIM_MODE=auto node scripts/simulate.js daemon",
    "sim:reset": "node scripts/simulate.js reset"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1024.0",
    "axios": "^1.7.7",
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^12.3.0",
    "fuse.js": "^7.1.0",
    "heic-convert": "^2.1.0",
    "lucide-react": "^0.554.0",
    "multer": "^2.0.2",
    "mysql2": "^3.15.3",
    "next": "^14.2.33",
    "npm-run-all": "^4.1.5",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "react": "18.3.1",
    "react-cookie-consent": "^10.0.1",
    "react-dom": "18.3.1",
    "remove-accents": "^0.5.0",
    "resend": "^6.10.0",
    "sharp": "^0.34.5",
    "swiper": "^12.0.3",
    "talisman": "^1.1.4",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.17",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^15.7.0",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.0",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
