{
  "name": "vetmybuilder-monorepo",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm-run-all -p dev:*",
    "dev:web": "cd web && next dev -p 3000",
    "dev:server": "node server/index.js",
    "build": "cd web && next build",
    "start": "npm-run-all -p start:*",
    "start:web": "cd web && next start -p 3000",
    "start:server": "node server/index.js",
    "test:api": "vitest run -c vitest.config.ts",
    "test:web": "vitest run -c vitest.web.config.ts",
    "test": "npm run test:api && npm run test:web && npm run posttest",
    "posttest": "node -e \"const fs=require('fs'),path=require('path'),os=require('os');const del=(dir,prefix)=>{try{for(const e of fs.readdirSync(dir,{withFileTypes:true})){if(e.isDirectory()&&e.name.startsWith(prefix)){fs.rmSync(path.join(dir,e.name),{recursive:true,force:true});}}}catch{}};del(process.cwd(),'.tmpdb-');del(os.tmpdir(),'vmb-tmpdb-');\""

  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^9.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase": "^12.3.0",
    "firebase-admin": "^12.5.0",
    "next": "^14.2.33",
    "npm-run-all": "^4.1.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.6.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.17",
    "jsdom": "^27.0.0",
    "postcss": "^8.4.38",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
