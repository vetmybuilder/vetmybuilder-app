# Next.js reads env from the *web/* folder.
# Copy this file to web/.env.local and fill the values.

# Full Firebase client config as a single-line JSON string. Example below.
# NEXT_PUBLIC_FIREBASE_CONFIG_JSON={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}

# OR set individual keys (used as fallback if JSON above is not set):
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# API base for Axios
NEXT_PUBLIC_API_BASE=http://localhost:8787

# NOTIFICATIONS
NEXT_PUBLIC_VAPID_PUBLIC_KEY=BO9C-YBzSbgzF8Eq0SQwiA7nR2NOa2rrooQGSvRIYE6mG9CkOJR5boUcsWENyefo_edSsW5hO4V17kNwvX9FJXE